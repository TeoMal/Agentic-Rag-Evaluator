# Template for .env -- no secrets in here, ever. .env is gitignored and is never
# copied into the Docker image (.dockerignore).
#   uv run scripts/deploy.py   creates .env from this file and prompts for anything blank.

# --- Azure OpenAI ---------------------------------------------------------------
# The two blanks are the only values you must supply (Azure portal -> your
# Azure OpenAI resource -> Keys and Endpoint).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini
# Embedding model deployment for RAG (e.g. text-embedding-3-small). Optional: without one (or if
# it does not exist on the resource) retrieval falls back to keyword (BM25) search.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Only if the embedding model is on ANOTHER resource: its URL (the resource, or the full
# .../openai/deployments/<name>/embeddings?api-version=... URL) and key.
AZURE_EMBEDDING_ENDPOINT=
AZURE_EMBEDDING_API_KEY=

# --- Agents and MCP -------------------------------------------------------------------
# mcp (default): the agents use the NFS MCP server, started per assessment over stdio.
# stub: offline test data -- never for a real assessment.
AGENT_TOOL_SOURCE=mcp
# Signs human approvals before record_assessment stores an assessment. deploy.py generates
# one when blank; by hand: python -c "import secrets; print(secrets.token_hex(32))"
MCP_APPROVAL_SECRET=

# --- Local stack (docker-compose.yml) -----------------------------------------------
# Local-only demo values; both ports bind to 127.0.0.1.
APP_PORT=8020
# localhost:5446 is for running the app on the host (`uv run hackathon2`);
# docker-compose.yml points the container at db:5432 instead.
POSTGRES_HOST=localhost
POSTGRES_PORT=5446
POSTGRES_USER=hackathon2
POSTGRES_PASSWORD=hackathon2-local
POSTGRES_DB=hackathon2

APP_ENV=development
LOG_LEVEL=INFO
